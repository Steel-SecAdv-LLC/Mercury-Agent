# Mercury-Agent runtime configuration (base defaults).
#
# Rendered into the `mercury-agent-config` ConfigMap by the base
# kustomization's configMapGenerator and injected wholesale via `envFrom`.
# Overlays override individual keys with `behavior: merge`.
#
# EVERY key here is read by shipped code. Sixteen `OMNI_*` keys that this
# ConfigMap used to carry (OMNI_LOG_LEVEL, OMNI_CACHE_DIR, OMNI_DATA_DIR,
# OMNI_MODEL_DIR, OMNI_API_HOST, OMNI_API_PORT, OMNI_API_WORKERS,
# OMNI_API_TIMEOUT, OMNI_ENABLE_METRICS, OMNI_ENABLE_TRACING,
# OMNI_ENABLE_PROFILING, OMNI_DEFAULT_SENSITIVITY, OMNI_MAX_BATCH_SIZE,
# OMNI_DETECTION_TIMEOUT, OMNI_ETHICS_ENABLED, OMNI_ETHICS_STRICT_MODE) have
# zero readers anywhere in src/: the API's host and port come from the
# container CMD's uvicorn arguments, and the rest name knobs that do not
# exist. Setting them changed nothing, which made the overlays' "production
# hardening" -- re-asserting OMNI_ETHICS_STRICT_MODE=true and
# OMNI_API_WORKERS=4 -- inert. They are gone; the keys the code actually
# reads are below, each annotated with its reader.

# --- Runtime mode ---------------------------------------------------------
# omni_mercury_engine._env.get_mercury_env(). Unset (the previous state of
# every k8s and Helm deployment path) means "development", which leaves the
# API-key hash salt at its hard-coded default, installs the localhost CORS
# allowlist, and makes the production JWT branch unreachable. The base is
# explicitly development; the staging and production overlays set
# MERCURY_ENV=production, which arms the fail-closed guards in
# api/auth.py.
MERCURY_ENV=development

# --- Durable platform state ----------------------------------------------
# api/key_store.py, api/rate_limit_store.py, api/quota_store.py and the
# identity/usage stores all key off MERCURY_KEYSTORE_PATH. Unset, every one
# of them falls back to per-process memory: an account registered on one
# replica cannot log in on another, API keys and quota counters die on
# restart, and the token-bucket limit multiplies by the replica count.
#
# The path is on the `mercury-agent-data` PersistentVolumeClaim, which the
# base declares ReadWriteMany and both deployments mount at /app/data.
#
# STORAGE REQUIREMENT: the RWX storage class backing that claim must provide
# working POSIX advisory locks and shared-memory mapping, because the store
# runs SQLite in WAL mode. CephFS, Longhorn RWX and AWS EFS (NFSv4.1) qualify;
# a plain NFSv3 export does not, and must not be used for this claim.
MERCURY_KEYSTORE_PATH=/app/data/mercury.db
MERCURY_AUDIT_LOG_DIR=/app/data/audit

# --- Reverse proxy --------------------------------------------------------
# api/client_ip.resolve_client_ip() and api/security_headers. Exactly one
# trusted hop: the ingress-nginx controller in front of the Service. Without
# this the rate limiter keys on the controller's own pod IP (one shared
# bucket for the whole internet) and X-Forwarded-Proto is ignored, so HSTS is
# never emitted behind TLS termination.
MERCURY_TRUSTED_PROXY_HOPS=1

# --- Request validation limits (api/server.py APIRequestValidator) --------
OMNI_MAX_DATA_POINTS=100000
OMNI_MAX_FEATURES=1000
OMNI_MAX_STRING_LENGTH=256
OMNI_MAX_NAN_RATIO=0.1
OMNI_MAX_INF_RATIO=0.01
OMNI_STRICT_VALIDATION=false

# --- Global rate limiter (api/server.py RateLimitMiddleware) --------------
OMNI_RATE_LIMIT_ENABLED=true
OMNI_RATE_LIMIT_REQUESTS_PER_MINUTE=100
OMNI_RATE_LIMIT_BURST=20

# --- Detector numerics (detectors/detection_config.py) --------------------
OMNI_DETECTOR_NAN_POLICY=neutral

# --- Streaming workers (`mercury stream`, the engine deployment's entrypoint)
# STREAMING_BACKEND defaults to the in-process "memory" backend so the base
# manifests run with no external broker; the distributed overlay patches it to
# "kafka" and supplies KAFKA_BOOTSTRAP_SERVERS / REDIS_URL.
STREAMING_BACKEND=memory
MERCURY_STREAM_INPUT_TOPIC=mercury-detections
MERCURY_STREAM_OUTPUT_TOPIC=mercury-anomalies
MERCURY_STREAM_CONSUMER_GROUP=mercury-streaming-workers
MERCURY_METRICS_PORT=9090
# The CLI's /metrics server binds loopback by default (secure-by-default on
# bare hosts). In-cluster, Prometheus scrapes cross-pod at
# <pod-ip>:MERCURY_METRICS_PORT, so widen the bind here explicitly.
MERCURY_METRICS_HOST=0.0.0.0

# --- Interpreter and numeric-library settings -----------------------------
OMP_NUM_THREADS=4
PYTORCH_CUDA_ALLOC_CONF=max_split_size_mb:512
TORCH_HOME=/app/models
PYTHONUNBUFFERED=1
PYTHONDONTWRITEBYTECODE=1
PYTHONHASHSEED=random
