# =============================================================================
# Mercury-Agent Environment Configuration Template
# =============================================================================
# Copy this file to .env and fill in the required values.
# NEVER commit .env files containing real secrets to version control.
#
# Legend:
#   [REQUIRED] - Must be set before starting the application
#   [OPTIONAL] - Has sensible defaults, customize as needed
#   [PRODUCTION] - Required for production deployments
# =============================================================================

# =============================================================================
# CORE SECRETS
# =============================================================================

# [PRODUCTION] Shared JWT signing key for API authentication.
# Resolution order (api/auth.py::JWTAuth): explicit argument, then this
# variable, then - in production only - derivation via AMA HD Key
# Management (seeded by AMA_MASTER_SEED below). Set this OR
# AMA_MASTER_SEED for any deployment with more than one worker/replica;
# without either, production derives a per-process key and logs a warning.
# Command: openssl rand -hex 32
JWT_SECRET_KEY=your-secure-random-key-here-generate-with-openssl-rand-hex-32

# =============================================================================
# OPTIONAL VARIABLES - Have sensible defaults
# =============================================================================

# -----------------------------------------------------------------------------
# API Server Configuration [OPTIONAL]
# -----------------------------------------------------------------------------

# Host address for API binding (0.0.0.0 = all interfaces)
OMNI_API_HOST=0.0.0.0

# Port for the API server
OMNI_API_PORT=8000

# Number of Uvicorn worker processes
OMNI_API_WORKERS=4

# -----------------------------------------------------------------------------
# Logging Configuration [OPTIONAL]
# -----------------------------------------------------------------------------

# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
OMNI_LOG_LEVEL=INFO

# Log format: json (structured), text (human-readable)
OMNI_LOG_FORMAT=json

# -----------------------------------------------------------------------------
# Rate Limiting [OPTIONAL]
# -----------------------------------------------------------------------------

# Enable/disable rate limiting (true/false)
OMNI_RATE_LIMIT_ENABLED=true

# Maximum requests per minute per client
OMNI_RATE_LIMIT_REQUESTS_PER_MINUTE=100

# Burst limit (max requests allowed in a burst)
OMNI_RATE_LIMIT_BURST=20

# -----------------------------------------------------------------------------
# Cache Configuration [OPTIONAL]
# -----------------------------------------------------------------------------

# PyTorch model cache directory
TORCH_HOME=/app/models

# -----------------------------------------------------------------------------
# Performance Tuning [OPTIONAL]
# -----------------------------------------------------------------------------

# Number of OpenMP threads for parallel computation
OMP_NUM_THREADS=4

# Python optimization flags
PYTHONUNBUFFERED=1
PYTHONDONTWRITEBYTECODE=1
PYTHONFAULTHANDLER=1

# =============================================================================
# PRODUCTION-ONLY VARIABLES
# =============================================================================

# -----------------------------------------------------------------------------
# Post-Quantum Cryptography Enforcement [PRODUCTION]
# -----------------------------------------------------------------------------

# No-op compatibility diagnostic: the import-time PQC gate is
# unconditional (omni_mercury_engine/_pqc_gate.py refuses to import
# without AMA Cryptography's native ML-DSA-65 / Kyber-1024 / SPHINCS+
# backend, regardless of this variable; pinned by
# tests/test_pqc_startup_gate.py). Setting it keeps legacy workflows
# readable. AVA_REQUIRE_REAL_PQC is the back-compat alias.
# AMA_REQUIRE_REAL_PQC=true
# AVA_REQUIRE_REAL_PQC=true  # back-compat alias

# Require AMA Cryptography's constant-time C primitives (HMAC/HKDF/SHA3).
# When set, Mercury Agent will refuse to fall back to pure-Python PQC
# implementations that do not provide timing-attack resistance.
# AMA_REQUIRE_CONSTANT_TIME=true

# -----------------------------------------------------------------------------
# Production Mode & Key Management [PRODUCTION]
# -----------------------------------------------------------------------------

# Canonical environment mode (omni_mercury_engine/_env.py).
# "development" (default) or "production"; unknown values raise loudly.
# MERCURY_ENV=production

# AMA HD Key Management master seed (hex). When set, HD-derived keys
# (JWT signing, API key, audit signing) are deterministic fleet-wide -
# the same seed on every worker/replica derives the same key material.
# Command: openssl rand -hex 64
# AMA_MASTER_SEED=your-128-hex-char-seed-generate-with-openssl-rand-hex-64

# Salt for API key hashing (api/auth.py); required in production -
# the first API-key hash raises without it.
# Command: openssl rand -hex 32
# API_KEY_HASH_SALT=your-salt-here

# Shared HMAC-SHA256 secret for Redis cache entry signing
# (integrations/stubs/cache.py::RedisCache). When set, entries are
# signed on write and verified on read; tampered or foreign-keyed
# entries raise CacheIntegrityError. Must match on every process
# sharing the Redis instance.
# MERCURY_CACHE_SECRET=your-cache-signing-secret

# Explicit CORS origin allow-list for the API (required in production).
# MERCURY_CORS_ORIGINS=https://your-frontend.example.com

# -----------------------------------------------------------------------------
# Database Configuration [OPTIONAL - Required if using persistence]
# -----------------------------------------------------------------------------

# Database connection URL (PostgreSQL recommended for production)
# Examples:
#   PostgreSQL: postgresql://user:password@localhost:5432/mercuryagent
#   SQLite: sqlite:///./mercury.db
# DATABASE_URL=postgresql://user:password@localhost:5432/mercuryagent

# -----------------------------------------------------------------------------
# TLS Configuration [PRODUCTION]
# -----------------------------------------------------------------------------

# Enable TLS encryption (REQUIRED for production deployments)
# OMNI_TLS_ENABLED=true
# OMNI_TLS_CERT_FILE=/path/to/cert.pem
# OMNI_TLS_KEY_FILE=/path/to/key.pem

# -----------------------------------------------------------------------------
# Monitoring & Observability [PRODUCTION]
# -----------------------------------------------------------------------------

# OpenTelemetry endpoint for distributed tracing
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

# Prometheus metrics port
# PROMETHEUS_METRICS_PORT=9090

# =============================================================================
# EXTERNAL API KEYS [OPTIONAL]
# =============================================================================

# Nixtla TimeGPT API Key (for foundation model integration)
# NIXTLA_API_KEY=your-nixtla-api-key

# OpenAI API Key (for LLM-based anomaly explanation)
# OPENAI_API_KEY=your-openai-api-key

# Anthropic API Key (for Claude-based features)
# ANTHROPIC_API_KEY=your-anthropic-api-key

# -----------------------------------------------------------------------------
# Domain Data Source API Keys [OPTIONAL]
# Required for specific domain loaders; see benchmarks/DATASOURCES.md
# -----------------------------------------------------------------------------

# NASA FIRMS (Fire Information for Resource Management System)
# Required for wildfire domain loader
# Register at: https://firms.modaps.eosdis.nasa.gov/api/map_key/
# NASA_FIRMS_MAP_KEY=your-nasa-firms-map-key

# FRED (Federal Reserve Economic Data)
# Required for financial crisis domain loader
# Register at: https://fred.stlouisfed.org/docs/api/api_key.html
# FRED_API_KEY=your-fred-api-key

# EIA (Energy Information Administration)
# Optional for energy grid domain loader (NOAA SWPC data is free)
# Register at: https://www.eia.gov/opendata/register.php
# EIA_API_KEY=your-eia-api-key

# Mercury domain loader cache directory
# MERCURY_CACHE_DIR=~/.mercury/cache

# Enable network tests (domain loaders hit real APIs)
# MERCURY_NETWORK_TESTS=0

# =============================================================================
# STARTUP VALIDATION
# =============================================================================
# Misconfiguration fails loudly at the relevant boundary: the PQC import
# gate raises at `import omni_mercury_engine`, unknown MERCURY_ENV values
# raise at first read, and production paths raise on missing secrets.
#
# To smoke-test your configuration:
#   python -c "import omni_mercury_engine; print('import OK')"
# =============================================================================
