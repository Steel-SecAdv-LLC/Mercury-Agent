# =============================================================================
# Mercury-Agent Environment Configuration Template
# =============================================================================
# Copy this file to .env and fill in the required values.
# NEVER commit .env files containing real secrets to version control.
#
# Legend:
#   [REQUIRED] - Must be set before starting the application
#   [OPTIONAL] - Has sensible defaults, customize as needed
#   [PRODUCTION] - Required for production deployments
# =============================================================================

# =============================================================================
# CORE SECRETS
# =============================================================================

# [PRODUCTION] Shared JWT signing key for API authentication.
# Resolution order (api/auth.py::JWTAuth): explicit argument, then this
# variable, then - in production only - derivation via AMA HD Key
# Management (seeded by AMA_MASTER_SEED below). Set this OR
# AMA_MASTER_SEED for any deployment with more than one worker/replica;
# without either, production derives a per-process key and logs a warning.
# Command: openssl rand -hex 32
JWT_SECRET_KEY=your-secure-random-key-here-generate-with-openssl-rand-hex-32

# =============================================================================
# OPTIONAL VARIABLES - Have sensible defaults
# =============================================================================

# -----------------------------------------------------------------------------
# API Server Configuration [OPTIONAL]
# -----------------------------------------------------------------------------

# Host address for API binding (0.0.0.0 = all interfaces)
OMNI_API_HOST=0.0.0.0

# Port for the API server
OMNI_API_PORT=8000

# Number of Uvicorn worker processes
OMNI_API_WORKERS=4

# -----------------------------------------------------------------------------
# Logging Configuration [OPTIONAL]
# -----------------------------------------------------------------------------

# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
OMNI_LOG_LEVEL=INFO

# Log format: json (structured), text (human-readable)
OMNI_LOG_FORMAT=json

# -----------------------------------------------------------------------------
# Rate Limiting [OPTIONAL]
# -----------------------------------------------------------------------------

# Enable/disable rate limiting (true/false)
OMNI_RATE_LIMIT_ENABLED=true

# Maximum requests per minute per client
OMNI_RATE_LIMIT_REQUESTS_PER_MINUTE=100

# Burst limit (max requests allowed in a burst)
OMNI_RATE_LIMIT_BURST=20

# -----------------------------------------------------------------------------
# Cache Configuration [OPTIONAL]
# -----------------------------------------------------------------------------

# PyTorch model cache directory
TORCH_HOME=/app/models

# -----------------------------------------------------------------------------
# Performance Tuning [OPTIONAL]
# -----------------------------------------------------------------------------

# Number of OpenMP threads for parallel computation
OMP_NUM_THREADS=4

# Python optimization flags
PYTHONUNBUFFERED=1
PYTHONDONTWRITEBYTECODE=1
PYTHONFAULTHANDLER=1

# =============================================================================
# PRODUCTION-ONLY VARIABLES
# =============================================================================

# -----------------------------------------------------------------------------
# Post-Quantum Cryptography Enforcement [PRODUCTION]
# -----------------------------------------------------------------------------

# No-op compatibility diagnostic: the import-time PQC gate is
# unconditional (omni_mercury_engine/_pqc_gate.py refuses to import
# without AMA Cryptography's native ML-DSA-65 / Kyber-1024 / SPHINCS+
# backend, regardless of this variable; pinned by
# tests/test_pqc_startup_gate.py). Setting it keeps legacy workflows
# readable. AVA_REQUIRE_REAL_PQC is the back-compat alias.
# AMA_REQUIRE_REAL_PQC=true
# AVA_REQUIRE_REAL_PQC=true  # back-compat alias

# Require AMA Cryptography's constant-time C primitives (HMAC/HKDF/SHA3).
# When set, Mercury Agent will refuse to fall back to pure-Python PQC
# implementations that do not provide timing-attack resistance.
# AMA_REQUIRE_CONSTANT_TIME=true

# Pinned AMA Cryptography version (Tier 0). The import-time gate refuses to
# start unless the installed ama_cryptography resolves to this *release*; if you
# set this variable it must resolve to the same release (a mismatch fails closed,
# it is never a downgrade). Matching is PEP 440-tolerant: v3.2.0, 3.2.0.post1,
# 3.2.0+cpu, and even 3.2 are accepted, while a different release like 3.1.0 is
# refused -- so a valid post/local build is not misread as a failure. Keep in
# lockstep with the pyproject git pin and CI AMA_REF. See
# omni_mercury_engine/_pqc_gate.py::_enforce_ama_version / _release_matches.
# AMA_CRYPTO_VERSION=3.2.0

# Native AMA library search path. scripts/build_ama_native.sh co-locates the
# shared object inside the installed package, so this is normally NOT needed.
# Only set it for a manual out-of-tree build:
# LD_LIBRARY_PATH=/tmp/ama-cryptography/build/lib:/tmp/ama-cryptography/build:${LD_LIBRARY_PATH:-}

# -----------------------------------------------------------------------------
# Harm-gate escalation & durable audit [PRODUCTION]
# -----------------------------------------------------------------------------

# Durable JSON-Lines sink for every harm-gate decision (refuse / escalate /
# approve / provenance). Defaults to <repo>/artifacts/audit/gate_decisions.jsonl
# in a source checkout, or <XDG_STATE_HOME>/mercury-agent/audit/ when installed.
# Point it at a persistent, backed-up path in production.
# MERCURY_GATE_AUDIT_LOG=/var/lib/mercury/audit/gate_decisions.jsonl

# Also forward each decision to the tamper-evident, hash-chained
# SecureAuditLogger (integrity-verifiable via verify_log_integrity). The secure
# sink is a SEPARATE location from the JSONL path above. See
# docs/ESCALATION_AUDIT_RUNBOOK.md.
# MERCURY_GATE_AUDIT_SECURELOG=1

# Directory for the hash-chained secure sink (audit.jsonl lives here). This is
# the only env knob for the secure sink's location; without it the sink defaults
# to ./audit_logs. Point it at a persistent, backed-up path in production.
# MERCURY_SECURE_AUDIT_DIR=/var/lib/mercury/audit/secure

# Disable harm-gate audit entirely (NOT recommended in production).
# MERCURY_GATE_AUDIT_DISABLED=1

# Make a lexical-only harm posture a FATAL enablement error instead of a
# warning: refuse to construct the general-capability surface unless a real
# meaning-level reasoning model backs the harm classifier (fail-closed).
# MERCURY_REQUIRE_REAL_HARM_CLASSIFIER=1

# -----------------------------------------------------------------------------
# Production Mode & Key Management [PRODUCTION]
# -----------------------------------------------------------------------------

# Canonical environment mode (omni_mercury_engine/_env.py).
# "development" (default) or "production"; unknown values raise loudly.
# MERCURY_ENV=production

# AMA HD Key Management master seed (hex). When set, HD-derived keys
# (JWT signing, API key, audit signing) are deterministic fleet-wide -
# the same seed on every worker/replica derives the same key material.
# Command: openssl rand -hex 64
# AMA_MASTER_SEED=your-128-hex-char-seed-generate-with-openssl-rand-hex-64

# Salt for API key hashing (api/auth.py); required in production -
# the first API-key hash raises without it.
# Command: openssl rand -hex 32
# API_KEY_HASH_SALT=your-salt-here

# Shared HMAC-SHA256 secret for Redis cache entry signing
# (integrations/stubs/cache.py::RedisCache). When set, entries are
# signed on write and verified on read; tampered or foreign-keyed
# entries raise CacheIntegrityError. Must match on every process
# sharing the Redis instance.
# MERCURY_CACHE_SECRET=your-cache-signing-secret

# Explicit CORS origin allow-list for the API. In production, unset
# means same-origin only (CORS middleware disabled, fail-closed); set
# this to enable cross-origin access.
# MERCURY_CORS_ORIGINS=https://your-frontend.example.com

# -----------------------------------------------------------------------------
# Database Configuration [OPTIONAL - Required if using persistence]
# -----------------------------------------------------------------------------

# Database connection URL (PostgreSQL recommended for production)
# Examples:
#   PostgreSQL: postgresql://user:password@localhost:5432/mercuryagent
#   SQLite: sqlite:///./mercury.db
# DATABASE_URL=postgresql://user:password@localhost:5432/mercuryagent

# -----------------------------------------------------------------------------
# TLS Configuration [PRODUCTION]
# -----------------------------------------------------------------------------

# Enable TLS encryption (REQUIRED for production deployments)
# OMNI_TLS_ENABLED=true
# OMNI_TLS_CERT_FILE=/path/to/cert.pem
# OMNI_TLS_KEY_FILE=/path/to/key.pem

# -----------------------------------------------------------------------------
# Monitoring & Observability [PRODUCTION]
# -----------------------------------------------------------------------------

# OpenTelemetry endpoint for distributed tracing
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

# Prometheus metrics port
# PROMETHEUS_METRICS_PORT=9090

# =============================================================================
# EXTERNAL API KEYS [OPTIONAL]
# =============================================================================

# Nixtla TimeGPT API Key (for foundation model integration)
# NIXTLA_API_KEY=your-nixtla-api-key

# -----------------------------------------------------------------------------
# Reasoning backend (LLM) — OPTIONAL
#
# Mercury's reasoning backend runs LOCAL and FREE by default: no key, no
# network, no cost. It uses a local Ollama model when present and a built-in
# deterministic template otherwise — you do not need any key below to run
# Mercury. A cloud provider is used ONLY if you explicitly set its key; none is
# preferred or enabled by default, and they are interchangeable backends behind
# Mercury, not the system itself.
#
# Local (default): install Ollama and pull a model, e.g.
#   ollama pull llama3.2:3b
# No environment variable is required for the local path.
#
# Served-model endpoint (Tier 0 canonical name): a loopback URL for the local
# reasoning backend, parsed into host+port. SafeHTTPClient enforces loopback,
# so it can only address a local server. The more specific MERCURY_OLLAMA_HOST /
# MERCURY_OLLAMA_MODEL still override it.
# MERCURY_MODEL_ENDPOINT=http://127.0.0.1:11434
# MERCURY_OLLAMA_HOST=127.0.0.1
# MERCURY_OLLAMA_MODEL=llama3.2:3b
#
# Meaning-level CI lane (ci/meaning-level). The lane runs on EVERY PR using a
# validated stdlib model double, so it is NOT toggled by an env var. Two knobs
# refine it, both CI repository variables (not process env vars):
#   CI_MEANING_LEVEL_ENABLED=true       -- marker for opting into a deeper
#       real-served-model run, applied by swapping in the real-Ollama serving
#       block (see the header comment in .github/workflows/tier0-safety.yml). It
#       does NOT switch the always-on lane on or off.
#   MERCURY_CI_REQUIRE_REAL_CLASSIFIER=1 -- makes the served-model test FAIL
#       (not skip) when no real/double classifier is serving, so the lane
#       measures rather than silently passing.
# CI_MEANING_LEVEL_ENABLED=true
# MERCURY_CI_REQUIRE_REAL_CLASSIFIER=1
#
# Hard air-gap: set MERCURY_OFFLINE=1 to disable EVERY cloud provider
# (local + template only), regardless of any key set below.
#
# Optional cloud providers — set only the one(s) you choose (listed
# alphabetically; order is not significant, none is the default):
# ANTHROPIC_API_KEY=your-anthropic-api-key
# COHERE_API_KEY=your-cohere-api-key
# CURSOR_API_KEY=your-cursor-api-key
# DEEPSEEK_API_KEY=your-deepseek-api-key
# GEMINI_API_KEY=your-gemini-api-key
# OPENAI_API_KEY=your-openai-api-key
# XAI_API_KEY=your-xai-api-key
# -----------------------------------------------------------------------------

# -----------------------------------------------------------------------------
# Web search backend (general-purpose capabilities) — OPTIONAL
#
# Mercury's open-web research (agent.research / answer) resolves search through a
# provider LADDER, tried in order, each fail-closed. The recommended rungs are
# operator-owned; the keyless DuckDuckGo HTML scrape is only a best-effort
# fallback (it rate-limits / changes markup without notice), enabled by default
# so a zero-config install still returns something.
#
#   1. Keyed engine (highest quality, contractually stable):
# BRAVE_API_KEY=your-brave-search-api-key
#
#   2. Self-hosted SearXNG (KEYLESS, self-hostable — the preferred offline-leaning
#      default; no SaaS dependency, runs under your control, pairs with Ollama):
# MERCURY_SEARXNG_URL=http://localhost:8080
#
#   3. DuckDuckGo scrape fallback — set to 0/false to refuse scraping entirely
#      (provider-only posture); default enabled.
# MERCURY_SEARCH_DDG_FALLBACK=1
# -----------------------------------------------------------------------------

# -----------------------------------------------------------------------------
# Domain Data Source API Keys [OPTIONAL]
# Required for specific domain loaders; see benchmarks/DATASOURCES.md
# -----------------------------------------------------------------------------

# NASA FIRMS (Fire Information for Resource Management System)
# Required for wildfire domain loader
# Register at: https://firms.modaps.eosdis.nasa.gov/api/map_key/
# NASA_FIRMS_MAP_KEY=your-nasa-firms-map-key

# FRED (Federal Reserve Economic Data)
# Required for financial crisis domain loader
# Register at: https://fred.stlouisfed.org/docs/api/api_key.html
# FRED_API_KEY=your-fred-api-key

# EIA (Energy Information Administration)
# Optional for energy grid domain loader (NOAA SWPC data is free)
# Register at: https://www.eia.gov/opendata/register.php
# EIA_API_KEY=your-eia-api-key

# Mercury domain loader cache directory
# MERCURY_CACHE_DIR=~/.mercury/cache

# Enable network tests (domain loaders hit real APIs)
# MERCURY_NETWORK_TESTS=0

# =============================================================================
# STARTUP VALIDATION
# =============================================================================
# Misconfiguration fails loudly at the relevant boundary: the PQC import
# gate raises at `import omni_mercury_engine`, unknown MERCURY_ENV values
# raise at first read, and production paths raise on missing secrets.
#
# To smoke-test your configuration:
#   python -c "import omni_mercury_engine; print('import OK')"
# =============================================================================
