# =============================================================================
# OMNI-AVA Environment Configuration Template
# =============================================================================
# Copy this file to .env and fill in the required values.
# NEVER commit .env files containing real secrets to version control.
# =============================================================================

# -----------------------------------------------------------------------------
# REQUIRED: Security Configuration
# -----------------------------------------------------------------------------

# JWT Secret Key (REQUIRED for authentication)
# Generate a secure random key: openssl rand -hex 32
JWT_SECRET_KEY=your-secure-random-key-here-generate-with-openssl-rand-hex-32

# -----------------------------------------------------------------------------
# API Server Configuration
# -----------------------------------------------------------------------------

# Host and port for the API server
OMNI_API_HOST=0.0.0.0
OMNI_API_PORT=8000
OMNI_API_WORKERS=4

# -----------------------------------------------------------------------------
# Logging Configuration
# -----------------------------------------------------------------------------

# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
OMNI_LOG_LEVEL=INFO

# Log format: json, text
OMNI_LOG_FORMAT=json

# -----------------------------------------------------------------------------
# Rate Limiting Configuration
# -----------------------------------------------------------------------------

# Enable/disable rate limiting (true/false)
OMNI_RATE_LIMIT_ENABLED=true

# Maximum requests per minute per client
OMNI_RATE_LIMIT_REQUESTS_PER_MINUTE=100

# Burst limit (max requests allowed in a burst)
OMNI_RATE_LIMIT_BURST=20

# -----------------------------------------------------------------------------
# Cache Configuration
# -----------------------------------------------------------------------------

# Cache directory for model weights and data
OMNI_CACHE_DIR=/app/cache

# PyTorch model cache directory
TORCH_HOME=/app/models

# -----------------------------------------------------------------------------
# Database Configuration (if using persistence)
# -----------------------------------------------------------------------------

# Database URL (PostgreSQL, SQLite, etc.)
# DATABASE_URL=postgresql://user:password@localhost:5432/omniava

# -----------------------------------------------------------------------------
# Optional: External API Keys
# -----------------------------------------------------------------------------

# Nixtla TimeGPT API Key (for foundation model integration)
# NIXTLA_API_KEY=your-nixtla-api-key

# OpenAI API Key (for LLM-based anomaly explanation)
# OPENAI_API_KEY=your-openai-api-key

# -----------------------------------------------------------------------------
# Optional: Monitoring & Observability
# -----------------------------------------------------------------------------

# OpenTelemetry endpoint for distributed tracing
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

# Prometheus metrics port
# PROMETHEUS_METRICS_PORT=9090

# -----------------------------------------------------------------------------
# Optional: Feature Flags
# -----------------------------------------------------------------------------

# Enable experimental features
OMNI_EXPERIMENTAL_FEATURES=false

# Enable ML-based detection (requires torch)
OMNI_ML_ENABLED=true

# Enable quantum simulation features
OMNI_QUANTUM_ENABLED=false

# -----------------------------------------------------------------------------
# Security: TLS Configuration
# -----------------------------------------------------------------------------

# Enable TLS (recommended for production)
# OMNI_TLS_ENABLED=true
# OMNI_TLS_CERT_FILE=/path/to/cert.pem
# OMNI_TLS_KEY_FILE=/path/to/key.pem

# -----------------------------------------------------------------------------
# Performance Tuning
# -----------------------------------------------------------------------------

# Number of OpenMP threads for parallel computation
OMP_NUM_THREADS=4

# Python optimization flags
PYTHONUNBUFFERED=1
PYTHONDONTWRITEBYTECODE=1
PYTHONFAULTHANDLER=1
