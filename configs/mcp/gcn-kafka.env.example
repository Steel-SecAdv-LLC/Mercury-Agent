# =============================================================================
# GCN Kafka client credentials -- TEMPLATE ONLY, NEVER FILLED IN HERE
# =============================================================================
# Issue a credential at https://gcn.nasa.gov/quickstart, then:
#
#   mkdir -p ~/.config/mercury
#   cp configs/mcp/gcn-kafka.env.example ~/.config/mercury/gcn-kafka.env
#   chmod 600 ~/.config/mercury/gcn-kafka.env
#   ${EDITOR:-vi} ~/.config/mercury/gcn-kafka.env      # paste the real values
#
# The destination is OUTSIDE this repository on purpose: a secret pasted into a
# tracked file lands in git history, in every clone, and in the transcript of
# any AI assistant that reads the working tree. scripts/gcn_kafka_keepalive.py
# refuses to read this file unless it is mode 600.
#
# To hand the credential to the MCP server instead of the script, export the
# same two variables into the shell that launches Claude Code -- .mcp.json
# references them as ${GCN_KAFKA_CLIENT_ID} / ${GCN_KAFKA_CLIENT_SECRET} and
# never stores the values:
#
#   set -a; . ~/.config/mercury/gcn-kafka.env; set +a; claude
#
# A secret manager is better still where one is available, e.g.
#   export GCN_KAFKA_CLIENT_SECRET="$(pass show gcn/kafka-client-secret)"
# =============================================================================

# [REQUIRED] Client id issued by GCN. Not secret, but paired with the secret.
GCN_KAFKA_CLIENT_ID=

# [REQUIRED] Client secret issued by GCN. Shown once at creation time.
GCN_KAFKA_CLIENT_SECRET=

# [OPTIONAL] Which GCN deployment to talk to. One of:
#   gcn.nasa.gov (production, default) | test.gcn.nasa.gov | dev.gcn.nasa.gov
# The broker (kafka.<domain>:9092) and the OIDC token endpoint
# (https://auth.<domain>/oauth2/token) are both derived from this.
# GCN_KAFKA_DOMAIN=gcn.nasa.gov

# [OPTIONAL] Override the derived broker address.
# GCN_KAFKA_BOOTSTRAP_SERVERS=kafka.gcn.nasa.gov:9092

# [OPTIONAL] Override where the keep-alive records its run history.
# GCN_KAFKA_STATE_FILE=~/.local/state/mercury/gcn-kafka-keepalive.json
