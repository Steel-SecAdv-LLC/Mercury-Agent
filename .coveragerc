# Coverage.py configuration
# Note: coverage.py reads this file *instead of* the ``[tool.coverage.*]``
# tables in pyproject.toml whenever it exists (``coverage debug config`` lists
# it as the only file read), so this is the configuration that applies. Keep
# the two in step; pyproject.toml's copy is read only if this file is removed.

[run]
source = src/omni_mercury_engine
branch = true
parallel = true
omit =
    */tests/*
    */test_*.py
    */__pycache__/*
    */site-packages/*

[report]
precision = 2
show_missing = true
skip_covered = false
# Note: ``fail_under`` is intentionally not set here.  It used to live
# in this file but that made every ``pytest --cov`` invocation across
# the repo silently inherit the same floor, including jobs like
# ``neuro-symbolic-tests`` that run a partial suite and therefore
# measure a different coverage shape than the full suite.  The
# per-job CI floors are configured directly in
# ``.github/workflows/ci.yml`` via ``--cov-fail-under=${{ env.* }}``
# (currently ``COVERAGE_THRESHOLD_CORE=33`` and
# ``COVERAGE_THRESHOLD_FULL=62``) so they apply only to the jobs
# that explicitly opt in.  The ``fail_under`` in pyproject.toml is therefore
# not applied to runs in this repository, and the 85 % project aspiration is
# prose (README "Coverage"), not a number any tool reads.
exclude_lines =
    pragma: no cover
    def __repr__
    raise AssertionError
    raise NotImplementedError
    if __name__ == .__main__.:
    if TYPE_CHECKING:
    if typing.TYPE_CHECKING:
    @abstractmethod
    @abc.abstractmethod

[html]
directory = htmlcov

[xml]
output = coverage.xml
