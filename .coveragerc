# Coverage.py configuration
# Note: Main configuration is in pyproject.toml [tool.coverage.*]
# This file exists for tools that don't read pyproject.toml coverage settings

[run]
source = src/omni_mercury_engine
branch = true
parallel = true
omit =
    */tests/*
    */test_*.py
    */__pycache__/*
    */site-packages/*

[report]
precision = 2
show_missing = true
skip_covered = false
# CI runs partial test subsets; threshold must be achievable by those runs.
# Full-suite goal (85%) is in pyproject.toml [tool.coverage.report].
fail_under = 10
exclude_lines =
    pragma: no cover
    def __repr__
    raise AssertionError
    raise NotImplementedError
    if __name__ == .__main__.:
    if TYPE_CHECKING:
    if typing.TYPE_CHECKING:
    @abstractmethod
    @abc.abstractmethod

[html]
directory = htmlcov

[xml]
output = coverage.xml
