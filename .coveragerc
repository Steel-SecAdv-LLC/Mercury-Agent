# Coverage.py configuration
# Note: Main configuration is in pyproject.toml [tool.coverage.*]
# This file exists for tools that don't read pyproject.toml coverage settings

[run]
source = src/omni_mercury_engine
branch = true
parallel = true
omit =
    */tests/*
    */test_*.py
    */__pycache__/*
    */site-packages/*

[report]
precision = 2
show_missing = true
skip_covered = false
# Local / nightly floor for tools that read `.coveragerc` instead of
# `pyproject.toml`.  Aligned with the CI full-suite floor in
# `.github/workflows/ci.yml` (COVERAGE_THRESHOLD_FULL).  The
# `pyproject.toml` `[tool.coverage.report] fail_under = 85` remains
# the strict aspirational bar for nightly runs.  See the comment block
# in `ci.yml` for the rationale behind ramping up from the legacy
# 10% scaffolding floor.
fail_under = 75
exclude_lines =
    pragma: no cover
    def __repr__
    raise AssertionError
    raise NotImplementedError
    if __name__ == .__main__.:
    if TYPE_CHECKING:
    if typing.TYPE_CHECKING:
    @abstractmethod
    @abc.abstractmethod

[html]
directory = htmlcov

[xml]
output = coverage.xml
