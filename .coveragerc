# Coverage.py configuration
# Note: Main configuration is in pyproject.toml [tool.coverage.*]
# This file exists for tools that don't read pyproject.toml coverage settings

[run]
source = src/omni_mercury_engine
branch = true
parallel = true
omit =
    */tests/*
    */test_*.py
    */__pycache__/*
    */site-packages/*

[report]
precision = 2
show_missing = true
skip_covered = false
# Note: ``fail_under`` is intentionally not set here.  It used to live
# in this file but that made every ``pytest --cov`` invocation across
# the repo silently inherit the same floor, including jobs like
# ``neuro-symbolic-tests`` that run a partial suite and therefore
# measure a different coverage shape than the full suite.  The
# per-job CI floors are configured directly in
# ``.github/workflows/ci.yml`` via ``--cov-fail-under=${{ env.* }}``
# (currently ``COVERAGE_THRESHOLD_CORE=25`` and
# ``COVERAGE_THRESHOLD_FULL=50``) so they apply only to the jobs
# that explicitly opt in.  The ``pyproject.toml
# [tool.coverage.report] fail_under = 85`` aspirational target
# remains in place for tools that read pyproject coverage settings.
exclude_lines =
    pragma: no cover
    def __repr__
    raise AssertionError
    raise NotImplementedError
    if __name__ == .__main__.:
    if TYPE_CHECKING:
    if typing.TYPE_CHECKING:
    @abstractmethod
    @abc.abstractmethod

[html]
directory = htmlcov

[xml]
output = coverage.xml
