[flake8]
max-line-length = 100
extend-ignore = E203, W503
exclude =
    .git,
    __pycache__,
    build,
    dist,
    .eggs,
    *.egg-info,
    .venv,
    venv,
    htmlcov,
    .pytest_cache,
    .mypy_cache
per-file-ignores =
    # Allow unused imports in __init__.py files (re-exports)
    */__init__.py: F401
    # Allow late imports in files that need conditional imports
    */utils/rng.py: E402
