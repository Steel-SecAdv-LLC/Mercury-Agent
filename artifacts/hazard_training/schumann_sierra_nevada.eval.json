    },
    {
      "description": "quiet-hour false-alarm rate at each path's deployed decision rule must not exceed physics",
      "higher_is_better": false,
      "metric": "false_alarm_rate_op"
    },
    {
      "description": "hour-level anomaly-type agreement with the derived labels must not regress below the physics assessment",
      "higher_is_better": true,
      "metric": "four_class_accuracy"
    }
  ],
